rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin') || request.auth.token.admin == true;
    }

    function isTeacher() {
      return isAdmin() || hasRole('teacher') || request.auth.token.teacher == true;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isTeacher();

      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && request.resource.data.role in ['student', 'parent'];

      allow update: if isSelf(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.xp == resource.data.xp
        && request.resource.data.coin == resource.data.coin
        && request.resource.data.gem == resource.data.gem
        && request.resource.data.level == resource.data.level
        && request.resource.data.streak == resource.data.streak
        && request.resource.data.completedLessons == resource.data.completedLessons
        && request.resource.data.lessonStars == resource.data.lessonStars
        && request.resource.data.unlockedBadges == resource.data.unlockedBadges
        && request.resource.data.inventory == resource.data.inventory
        && request.resource.data.history == resource.data.history
        && request.resource.data.highScores == resource.data.highScores
        || isAdmin();

      allow delete: if isAdmin();

      match /history/{historyId} {
        allow read: if isSelf(userId) || isTeacher();
        allow write: if isAdmin();
      }

      match /inventory/{itemId} {
        allow read: if isSelf(userId);
        allow write: if isAdmin();
      }
    }

    match /classrooms/{classId} {
      allow read: if isTeacher();
      allow write: if isTeacher();
      match /assignments/{assignmentId} {
        allow read, write: if isTeacher();
      }
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /worlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}