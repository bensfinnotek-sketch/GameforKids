rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin') || request.auth.token.admin == true;
    }

    function isTeacher() {
      return isAdmin() || hasRole('teacher') || request.auth.token.teacher == true;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isTeacher();

      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && request.resource.data.role in ['student', 'parent'];

      // Account ownership is enforced by Firebase Auth. The client may persist
      // progress generated by real learning/game activity, but cannot change
      // its UID or privilege role.
      allow update: if (isSelf(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role)
        || isAdmin();

      allow delete: if isAdmin();

      match /history/{historyId} {
        allow read: if isSelf(userId) || isTeacher();
        allow write: if isAdmin();
      }

      // Learning submissions are append-only. They provide an auditable activity trail
      // while reward calculation remains a separate trusted-backend concern.
      match /lessonAttempts/{attemptId} {
        allow read: if isSelf(userId) || isTeacher();
        allow create: if isSelf(userId)
          && request.resource.data.lessonId is string
          && request.resource.data.lessonId.size() > 0
          && request.resource.data.score is int
          && request.resource.data.totalQuestions is int
          && request.resource.data.score >= 0
          && request.resource.data.totalQuestions > 0
          && request.resource.data.score <= request.resource.data.totalQuestions
          && request.resource.data.timeSpentSeconds is int
          && request.resource.data.timeSpentSeconds >= 0
          && request.resource.data.timeSpentSeconds <= 86400
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if false;
      }

      match /inventory/{itemId} {
        allow read: if isSelf(userId);
        allow write: if isAdmin();
      }
    }

    match /classrooms/{classId} {
      allow read: if isTeacher();
      allow write: if isTeacher();
      match /assignments/{assignmentId} {
        allow read, write: if isTeacher();
      }
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /worlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}