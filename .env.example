# Client-side Firebase configuration used by Google/Email Authentication and Firestore.
# Get these values from Firebase Console -> Project settings -> Your apps -> Web app.
# Do NOT use the old demo values that were previously committed here.

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional application metadata used by some hosting environments.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="https://gamefor-kids.vercel.app"
